# For `python receiver/receiver.py --cloud` (receiver/cloud_bridge.py). Copy to .env and fill in;
# the values are in homecookd's .env (GLASSES_*, CONVEX_SITE_URL, GCS_UPLOAD_BUCKET, GEMINI_API_KEY).
CONVEX_SITE_URL=https://grand-dragon-649.convex.site
GLASSES_SECRET=
GCS_UPLOAD_BUCKET=edible-uploads-379797517579
# The glasses VM, for the live copy homie looks at. Leave empty for no relay.
GLASSES_URL=ws://<vm-ip>:8090
GLASSES_DEVICE_KEY=
# Live analysis (leave empty, or pass --no-live, to skip it)
GEMINI_API_KEY=
# GCS uploads use your gcloud login (gcloud auth login) unless this is set:
# GOOGLE_ACCESS_TOKEN=
