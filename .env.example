GEMINI_API_KEY=
# Pro model for the merge; extraction uses GEMINI_EXTRACT_MODEL (defaults to GEMINI_MODEL)
GEMINI_MODEL=gemini-3.1-pro-preview
# Leave blank to use GEMINI_MODEL; set to gemini-3.8-flash if a 15-min Pro extraction takes over ~3 min
GEMINI_EXTRACT_MODEL=
GCS_MEDIA_BUCKET=edible-media-379797517579
GCS_UPLOAD_BUCKET=edible-uploads-379797517579
# Stop starting new jobs once estimated Gemini spend (from data/out/*/work/usage.json) passes this
MAX_SPEND_USD=15
FAMILY_CODE=
GCP_PROJECT=project-11b9fc8a-1108-4ea8-a3b

# Cartesia (Sonic TTS / Ink STT). Server-only: never in app/ or web/. Also a Supabase edge-function secret.
CARTESIA_API_KEY=

# Moss semantic search (server only; set as Supabase secrets for the api function)
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Convex team access token (server/CLI only: never in app/ or web/, never NEXT_PUBLIC_/EXPO_PUBLIC_). `npx convex dev` writes CONVEX_DEPLOYMENT and CONVEX_URL to .env.local.
CONVEX_OVERRIDE_ACCESS_TOKEN=
# Dev deploy key for the homecookd dev deployment (dashboard > Settings > Deploy keys). Lets `npx convex dev` run without `npx convex login`.
CONVEX_DEPLOY_KEY=
# Public deployment URL (safe to share)
CONVEX_URL=https://upbeat-lobster-139.convex.cloud
