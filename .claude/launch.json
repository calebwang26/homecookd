{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "homecookd-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd app && npx expo start --web --port 8081 --clear"],
      "port": 8081
    },
    {
      "name": "expo-go",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd app && CI=1 npx expo start --go --tunnel --port 8082"],
      "port": 8082
    },
    {
      "name": "lander",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd web && npm run dev -- --port 3000"],
      "port": 3000
    }
  ]
}
