# Public, non-secret config for the Expo app. Copy to app/.env and fill in.
# Never put a service key or any other secret here: EXPO_PUBLIC_* values ship inside the app bundle.

# Public bucket base URL, e.g. https://storage.googleapis.com/<bucket> (no trailing slash)
EXPO_PUBLIC_BUCKET_URL=
# Upload endpoint that returns signed PUT URLs for a new job
EXPO_PUBLIC_UPLOAD_URL=
# Shared family code sent as the X-Edible-Family header
EXPO_PUBLIC_FAMILY_CODE=

# Hackathon (docs/build/STACK.md). Convex deployment URL (public) and the live voice service (Track B).
# Without the voice URL, cook mode's mic talks to a local stub (lib/live/voice.ts).
EXPO_PUBLIC_CONVEX_URL=https://grand-dragon-649.convex.cloud
EXPO_PUBLIC_VOICE_URL=
